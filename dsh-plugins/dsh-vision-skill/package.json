{
  "name": "dsh-vision-skill",
  "version": "0.3.0",
  "description": "DSH 标准插件版 vision skill：识别本地图片（vision_analyze/vision_ocr/vision_ground/vision_detect/vision_dominant_colors/vision_long_screenshot_ocr/vision_clipboard），任意 OpenAI 兼容多模态模型可接入（默认 MiniMax-M3），思考关闭。零框架补丁，Schemastery 配置校验。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts/vision.py",
    "templates",
    "cordis.patch.yml",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugins",
    "vision",
    "ocr",
    "grounding",
    "text-only-llm",
    "agent-skills"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DDDFXYqiming/Agent_Extensions.git",
    "directory": "dsh-plugins/dsh-vision-skill"
  },
  "engines": {
    "node": ">=22.19"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  }
}